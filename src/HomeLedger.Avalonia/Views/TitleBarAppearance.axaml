<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com" xmlns:u="https://irihi.tech/ursa"
             xmlns:l="using:HomeLedger.Core.I18n" xmlns:services="using:HomeLedger.Avalonia.Services"
             x:Class="HomeLedger.Avalonia.Views.TitleBarAppearance" x:DataType="services:AppearanceService">
  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <ThemeVariantScope x:Name="TitleBarThemeScope" RequestedThemeVariant="{Binding ThemeMode, Mode=TwoWay, Converter={x:Static codewf:StudioThemeModeConverter.Instance}}">
      <ThemeVariantScope.Resources>
        <TextBlock x:Key="STRING_THEME_TOGGLE_SYSTEM" Text="{codewf:I18n {x:Static l:Language.AppearanceSystem}}" />
        <TextBlock x:Key="STRING_THEME_TOGGLE_LIGHT" Text="{codewf:I18n {x:Static l:Language.AppearanceLight}}" />
        <TextBlock x:Key="STRING_THEME_TOGGLE_DARK" Text="{codewf:I18n {x:Static l:Language.AppearanceDark}}" />
      </ThemeVariantScope.Resources>
      <u:ThemeToggleButton x:Name="TitleBarThemeToggle" Width="30" Height="30" IsThreeState="True" TargetScope="{Binding #TitleBarThemeScope}" ToolTip.Tip="{codewf:I18n {x:Static l:Language.AppearanceMode}}" />
    </ThemeVariantScope>
    <ListBox x:Name="TitleBarPalettes" Classes="studio-palettes" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette, Mode=TwoWay}">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate x:DataType="services:AppearanceOption"><Ellipse Width="13" Height="13" Fill="{Binding Swatch}" ToolTip.Tip="{Binding DisplayName}" /></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <ComboBox x:Name="TitleBarLanguageSelector" Width="50" MinHeight="0" Height="30" Padding="6,0" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" HorizontalContentAlignment="Left" ToolTip.Tip="{codewf:I18n {x:Static l:Language.AppearanceLanguage}}">
      <ComboBox.SelectionBoxItemTemplate><DataTemplate><PathIcon Width="16" Height="16" Data="{DynamicResource SemiIconLanguage}" /></DataTemplate></ComboBox.SelectionBoxItemTemplate>
      <ComboBox.ItemTemplate><DataTemplate x:DataType="services:AppearanceOption"><TextBlock MinWidth="120" Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
  </StackPanel>
</UserControl>
