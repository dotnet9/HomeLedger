<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui" xmlns:codewf="https://codewf.com"
        xmlns:l="using:HomeLedger.Core.I18n" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeLedger.Avalonia.Views.MainWindow"
        Title="{codewf:I18n {x:Static l:Language.AppTitle}}" Width="1280" Height="840" MinWidth="960" MinHeight="640"
        Icon="avares://HomeLedger.Avalonia/Assets/logo.ico"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource StudioBackground}">
    <DockPanel>
        <!-- 侧边导航：玉账浮层 -->
        <Border DockPanel.Dock="Left" Width="210" Margin="12,0,0,12" Padding="10"
                Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="{codewf:I18n {x:Static l:Language.AppearanceTitle}}" Click="OnAppearance" Margin="0,0,0,8" HorizontalAlignment="Stretch" CornerRadius="10"/><Button x:Name="ChangePasswordButton" Content="{codewf:I18n {x:Static l:Language.ChangePassword}}" Click="OnChangePassword"
                            Margin="0,0,0,8" HorizontalAlignment="Stretch" CornerRadius="10"/>
                    <Button x:Name="LogoutButton" Content="{codewf:I18n {x:Static l:Language.SwitchAccount}}" Click="OnLogout"
                            ToolTip.Tip="{codewf:I18n {x:Static l:Language.LogoutHint}}"
                            Margin="0,0,0,12" HorizontalAlignment="Stretch" CornerRadius="10"/>
                    <Button x:Name="CheckUpdateButton" Content="{codewf:I18n {x:Static l:Language.AboutTitle}}" Click="OnCheckUpdate"
                            ToolTip.Tip="{codewf:I18n {x:Static l:Language.AboutUpdateHint}}"
                            Margin="0,0,0,12" HorizontalAlignment="Stretch" CornerRadius="10"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0,0,6">
                        <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource FinancePositiveSurface}">
                            <TextBlock Text="{Binding AvatarText}" Foreground="{DynamicResource StudioAccent}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RoleText}" MaxWidth="140" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource StudioMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPageIndex}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="CornerRadius" Value="11"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource StudioText}"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Background" Value="{DynamicResource StudioRaised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource StudioText}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="{DynamicResource StudioAccent}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="14"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding CurrentPage}" Margin="16,16,16,20"/>
        </ScrollViewer>
    </DockPanel>
</codewf:CodeWFWindow>
