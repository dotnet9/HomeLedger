<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeLedger.Avalonia.Views.Dialogs.DepositDialog"
        Title="存入存款" Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#f7f5f0">
    <Border Margin="14" CornerRadius="14" Background="White" BorderBrush="#e9e5dc" BorderThickness="1" Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="存入存款" FontSize="16" FontWeight="Bold" Foreground="#147d64"/>
            <TextBlock Text="存在父母处的钱，单利按日计息" FontSize="12" Foreground="#99a096"/>
            <TextBlock Text="金额" FontSize="12" Foreground="#5a6058"/>
            <TextBox x:Name="AmountBox" Watermark="0.00" Height="40" FontSize="18" FontFamily="Georgia"/>
            <TextBlock Text="年利率（百分数，默认 10 表示 10%，每笔可单独设置）" FontSize="12" Foreground="#5a6058"/>
            <TextBox x:Name="RateBox" Height="36"/>
            <TextBlock Text="存入日期（起息日）" FontSize="12" Foreground="#5a6058"/>
            <DatePicker x:Name="DatePicker"/>
            <TextBlock Text="备注" FontSize="12" Foreground="#5a6058"/>
            <TextBox x:Name="NoteBox" Watermark="选填…" Height="36"/>
            <TextBlock x:Name="ErrorText" Foreground="#c4553d" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" Click="OnCancel" CornerRadius="10" MinWidth="72"/>
                <Button Content="存入" Click="OnConfirm" Background="#147d64" Foreground="White" CornerRadius="10" MinWidth="88"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
