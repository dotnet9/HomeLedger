<jade:JadeWindow xmlns="https://github.com/avaloniaui" xmlns:jade="using:HomeLedger.Avalonia.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeLedger.Avalonia.Views.Dialogs.TransactionDialog"
        Title="记一笔" Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#f7f5f0"
        x:Name="Root">
    <Border Margin="14" CornerRadius="14" Background="White" BorderBrush="#e9e5dc" BorderThickness="1" Padding="24">
        <StackPanel Spacing="12">
            <TextBlock x:Name="HeaderText" Text="记一笔" FontSize="16" FontWeight="Bold" Foreground="#147d64"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton x:Name="ExpenseRadio" Content="支出" IsChecked="True" CornerRadius="8"/>
                <RadioButton x:Name="IncomeRadio" Content="收入" CornerRadius="8"/>
            </StackPanel>
            <TextBlock Text="金额" FontSize="12" Foreground="#5a6058"/>
            <TextBox x:Name="AmountBox" Watermark="0.00" Height="40" FontSize="18" FontFamily="Georgia"/>
            <TextBlock Text="日期" FontSize="12" Foreground="#5a6058"/>
            <DatePicker x:Name="DatePicker"/>
            <TextBlock Text="分类" FontSize="12" Foreground="#5a6058"/>
            <ComboBox x:Name="CategoryBox" Height="36" HorizontalAlignment="Stretch"/>
            <TextBlock Text="备注" FontSize="12" Foreground="#5a6058"/>
            <TextBox x:Name="NoteBox" Watermark="选填…" Height="36"/>
            <TextBlock x:Name="ErrorText" Foreground="#c4553d" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" Click="OnCancel" CornerRadius="10" MinWidth="72"/>
                <Button Content="保存" Click="OnConfirm" Background="#147d64" Foreground="White" CornerRadius="10" MinWidth="88"/>
            </StackPanel>
        </StackPanel>
    </Border>
</jade:JadeWindow>
