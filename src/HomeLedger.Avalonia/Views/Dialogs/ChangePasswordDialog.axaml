<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeLedger.Avalonia.Views.Dialogs.ChangePasswordDialog"
        Title="修改密码" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#f7f5f0">
    <Border Margin="14" CornerRadius="14" Background="White" BorderBrush="#e9e5dc" BorderThickness="1" Padding="24">
        <StackPanel Spacing="12">
            <TextBlock x:Name="HeaderText" Text="修改密码" FontSize="16" FontWeight="Bold" Foreground="#147d64"/>
            <TextBlock Text="新密码" FontSize="12" Foreground="#5a6058"/>
            <TextBox x:Name="NewPasswordBox" PasswordChar="●" Height="36"/>
            <TextBlock Text="确认新密码" FontSize="12" Foreground="#5a6058"/>
            <TextBox x:Name="ConfirmBox" PasswordChar="●" Height="36"/>
            <TextBlock x:Name="ErrorText" Foreground="#c4553d" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" Click="OnCancel" CornerRadius="10" MinWidth="72"/>
                <Button Content="确认修改" Click="OnConfirm" Background="#147d64" Foreground="White" CornerRadius="10" MinWidth="88"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
