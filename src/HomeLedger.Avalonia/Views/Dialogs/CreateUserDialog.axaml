<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui" xmlns:codewf="https://codewf.com"
        xmlns:l="using:HomeLedger.Core.I18n" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeLedger.Avalonia.Views.Dialogs.CreateUserDialog"
        Title="{codewf:I18n {x:Static l:Language.CreateMember}}" Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource StudioBackground}">
    <Border Margin="14" CornerRadius="14" Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" Padding="24">
        <StackPanel Spacing="12">
            <TextBlock x:Name="HeaderText" Text="{codewf:I18n {x:Static l:Language.CreateMember}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource StudioAccent}"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.UsernameHint}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
            <TextBox x:Name="UsernameBox" Height="36" TextChanged="OnInputChanged"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.DisplayNameHint}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
            <TextBox x:Name="DisplayNameBox" Height="36" TextChanged="OnInputChanged"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.InitialPasswordHint}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
            <TextBox x:Name="PasswordBox" PasswordChar="●" Height="36" TextChanged="OnInputChanged"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource FinanceExpense}" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{codewf:I18n {x:Static l:Language.Cancel}}" Click="OnCancel" IsCancel="True" CornerRadius="10" MinWidth="72"/>
                <Button x:Name="ConfirmButton" Content="{codewf:I18n {x:Static l:Language.Create}}" Click="OnConfirm" IsDefault="True" IsEnabled="False" Theme="{DynamicResource SolidButton}" CornerRadius="10" MinWidth="88"/>
            </StackPanel>
        </StackPanel>
    </Border>
</codewf:CodeWFWindow>
