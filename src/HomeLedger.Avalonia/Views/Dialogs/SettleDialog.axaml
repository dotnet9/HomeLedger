<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui" xmlns:codewf="https://codewf.com"
        xmlns:l="using:HomeLedger.Core.I18n" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeLedger.Avalonia.Views.Dialogs.SettleDialog"
        Title="{codewf:I18n {x:Static l:Language.SettleTitle}}" Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource StudioBackground}">
    <Border Margin="14" CornerRadius="14" Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="{codewf:I18n {x:Static l:Language.SettleConfirmTitle}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource StudioAccent}"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.SettleHint}}" FontSize="12" Foreground="{DynamicResource StudioText}" TextWrapping="Wrap"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.SettlementDate}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
            <DatePicker x:Name="DatePicker"/>
            <TextBlock x:Name="DetailText" FontSize="12" Foreground="{DynamicResource StudioText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TotalText" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FinanceIncome}"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{codewf:I18n {x:Static l:Language.Cancel}}" Click="OnCancel" IsCancel="True" CornerRadius="10" MinWidth="72"/>
                <Button x:Name="ConfirmButton" Content="{codewf:I18n {x:Static l:Language.ConfirmSettlement}}" Click="OnConfirm" IsDefault="True" Theme="{DynamicResource SolidButton}" CornerRadius="10" MinWidth="88"/>
            </StackPanel>
        </StackPanel>
    </Border>
</codewf:CodeWFWindow>
