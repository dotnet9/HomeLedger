<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui" xmlns:codewf="https://codewf.com"
        xmlns:l="using:HomeLedger.Core.I18n" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeLedger.Avalonia.Views.Dialogs.WithdrawDialog"
        Title="{codewf:I18n {x:Static l:Language.WithdrawDeposit}}" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource StudioBackground}">
    <Border Margin="14" CornerRadius="14" Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="{codewf:I18n {x:Static l:Language.WithdrawDeposit}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource StudioAccent}"/>
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource StudioText}"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.WithdrawalAmount}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
            <TextBox x:Name="AmountBox" Height="40" FontSize="18" FontFamily="Georgia" TextChanged="OnInputChanged"/>
            <TextBlock x:Name="MaxText" FontSize="12" Foreground="{DynamicResource StudioMuted}"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.WithdrawalDate}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
            <DatePicker x:Name="DatePicker"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.Note}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
            <TextBox x:Name="NoteBox" PlaceholderText="{codewf:I18n {x:Static l:Language.Optional}}" Height="36"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.PartialWithdrawalHint}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource FinanceExpense}" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{codewf:I18n {x:Static l:Language.Cancel}}" Click="OnCancel" IsCancel="True" CornerRadius="10" MinWidth="72"/>
                <Button x:Name="ConfirmButton" Content="{codewf:I18n {x:Static l:Language.Withdraw}}" Click="OnConfirm" IsDefault="True" IsEnabled="False" Background="{DynamicResource StudioAccent}" Foreground="White" CornerRadius="10" MinWidth="88"/>
            </StackPanel>
        </StackPanel>
    </Border>
</codewf:CodeWFWindow>
