<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:HomeLedger.Core.I18n" xmlns:codewf="https://codewf.com" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HomeLedger.Avalonia.Controls"
             x:Class="HomeLedger.Avalonia.Views.Pages.AdminOverviewPage">
    <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{codewf:I18n {x:Static l:Language.FamilyOverview}}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Width="34" Height="4" VerticalAlignment="Center" Margin="10,12,0,0" Background="{DynamicResource StudioAccent}"/>
        </StackPanel>
        <TextBlock Text="{codewf:I18n {x:Static l:Language.OverviewDescription}}" FontSize="13" Foreground="{DynamicResource StudioMuted}" Margin="0,-8,0,0"/>

        <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="{codewf:I18n {x:Static l:Language.ChartsOverview}}" Classes="primary"/><Button Content="{codewf:I18n {x:Static l:Language.TransactionDetails}}" Click="OnOpenDetails"/></StackPanel>
        <UniformGrid Columns="4">
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="{DynamicResource StudioAccent}"/><TextBlock Text="{codewf:I18n {x:Static l:Language.YearIncome}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/></StackPanel>
                    <TextBlock x:Name="IncomeText" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Foreground="{DynamicResource FinanceIncome}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="{DynamicResource StudioAccent}"/><TextBlock Text="{codewf:I18n {x:Static l:Language.YearExpense}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/></StackPanel>
                    <TextBlock x:Name="ExpenseText" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Foreground="{DynamicResource FinanceExpense}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="{DynamicResource StudioAccent}"/><TextBlock Text="{codewf:I18n {x:Static l:Language.YearBalance}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/></StackPanel>
                    <TextBlock x:Name="BalanceText" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="7,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="{DynamicResource StudioAccent}"/><TextBlock Text="{codewf:I18n {x:Static l:Language.DepositTotalLabel}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/></StackPanel>
                    <TextBlock x:Name="DepositTotalText" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Foreground="{DynamicResource StudioAccent}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{codewf:I18n {x:Static l:Language.Year}}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource StudioText}"/>
            <ComboBox x:Name="YearBox" MinWidth="110" SelectionChanged="OnYearChanged"/>
            <Panel Width="10"/>
            <TextBlock Text="{codewf:I18n {x:Static l:Language.ExportFamilyReport}}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource StudioMuted}"/>
            <Button Content="📄 CSV" Click="OnExportCsv" CornerRadius="10"/>
            <Button Content="📑 PDF" Click="OnExportPdf" CornerRadius="10"/>
            <Button Content="📝 Word" Click="OnExportDocx" Background="{DynamicResource StudioAccent}" Foreground="White" CornerRadius="10"/>
            <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" IsVisible="False"/>
        </StackPanel>

        <Grid ColumnDefinitions="1.2*,1*">
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.FamilyMonthlyTrend}}" FontSize="14" FontWeight="Bold"/>
                    <ctl:BarChartControl x:Name="BarChart" Height="200" Margin="0,10"
                        InLabel="{codewf:I18n {x:Static l:Language.Income}}" OutLabel="{codewf:I18n {x:Static l:Language.Expense}}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="7,0,0,0" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.MemberComparison}}" FontSize="14" FontWeight="Bold"/>
                    <ItemsControl x:Name="MemberComparison" Margin="0,10,0,16">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="85,*,100" ColumnSpacing="10" Margin="0,5">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                <StackPanel Grid.Column="1" Spacing="3"><ProgressBar Value="{Binding IncomeValue}" Maximum="100" Height="8" Foreground="{DynamicResource FinanceIncome}"/><ProgressBar Value="{Binding ExpenseValue}" Maximum="100" Height="8" Foreground="{DynamicResource FinanceExpense}"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.FamilyCategoryShare}}" FontSize="14" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="160,1*">
                        <ctl:DonutControl x:Name="Donut" Width="140" Height="140" Margin="0,10" HorizontalAlignment="Center"/>
                        <ItemsControl x:Name="CategoryList" Grid.Column="1" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                                        <Border Width="10" Height="10" Background="{Binding Color}" CornerRadius="3"/>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
                                        <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="Bold" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="{codewf:I18n {x:Static l:Language.MemberSummaryDetails}}" FontSize="14" FontWeight="Bold"/>
                <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,1*,1*" Margin="8,0">
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Member}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Income}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="1"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Expense}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="2"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Balance}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="3"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.DepositPrincipal}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="4"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.AccruedInterest}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="5"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.PrincipalAndInterest}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="6"/>
                </Grid>
                <ItemsControl x:Name="MemberList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,1*,1*" Margin="8,7">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Income}" FontSize="13" Foreground="{DynamicResource FinanceIncome}" Grid.Column="1"/>
                                <TextBlock Text="{Binding Expense}" FontSize="13" Foreground="{DynamicResource FinanceExpense}" Grid.Column="2"/>
                                <TextBlock Text="{Binding Balance}" FontSize="13" FontWeight="Bold" Grid.Column="3"/>
                                <TextBlock Text="{Binding Principal}" FontSize="13" Grid.Column="4"/>
                                <TextBlock Text="{Binding Accrued}" FontSize="13" Grid.Column="5"/>
                                <TextBlock Text="{Binding Total}" FontSize="13" FontWeight="Bold" Grid.Column="6"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
