<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HomeLedger.Avalonia.Controls"
             x:Class="HomeLedger.Avalonia.Views.Pages.AdminOverviewPage">
    <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="全家总览" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Width="34" Height="4" VerticalAlignment="Center" Margin="10,12,0,0" Background="#d9a441"/>
        </StackPanel>
        <TextBlock Text="管理员视角 · 全部成员（含存款利息）" FontSize="13" Foreground="#99a096" Margin="0,-8,0,0"/>

        <UniformGrid Columns="4">
            <Border Background="White" BorderBrush="#e9e5dc" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="#d9a441"/><TextBlock Text=" 本年收入" FontSize="12" Foreground="#99a096"/></StackPanel>
                    <TextBlock x:Name="IncomeText" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Foreground="#2f9e6e" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#e9e5dc" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="#d9a441"/><TextBlock Text=" 本年支出" FontSize="12" Foreground="#99a096"/></StackPanel>
                    <TextBlock x:Name="ExpenseText" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Foreground="#c4553d" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#e9e5dc" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="#d9a441"/><TextBlock Text=" 本年结余" FontSize="12" Foreground="#99a096"/></StackPanel>
                    <TextBlock x:Name="BalanceText" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#e9e5dc" BorderThickness="1" CornerRadius="16" Padding="16" Margin="7,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="#d9a441"/><TextBlock Text=" 存款本息合计" FontSize="12" Foreground="#99a096"/></StackPanel>
                    <TextBlock x:Name="DepositTotalText" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Foreground="#147d64" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="年度" FontSize="13" VerticalAlignment="Center" Foreground="#5a6058"/>
            <ComboBox x:Name="YearBox" MinWidth="110" SelectionChanged="OnYearChanged"/>
            <Panel Width="10"/>
            <TextBlock Text="导出全家报表：" FontSize="13" VerticalAlignment="Center" Foreground="#99a096"/>
            <Button Content="📄 CSV" Click="OnExportCsv" CornerRadius="10"/>
            <Button Content="📑 PDF" Click="OnExportPdf" CornerRadius="10"/>
            <Button Content="📝 Word" Click="OnExportDocx" Background="#147d64" Foreground="White" CornerRadius="10"/>
        </StackPanel>

        <Grid ColumnDefinitions="1.2*,1*">
            <Border Background="White" BorderBrush="#e9e5dc" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="月度收支趋势（全家）" FontSize="14" FontWeight="Bold"/>
                    <ctl:BarChartControl x:Name="BarChart" Height="200" Margin="0,10"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#e9e5dc" BorderThickness="1" CornerRadius="16" Padding="16" Margin="7,0,0,0" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="支出分类占比（全家）" FontSize="14" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="160,1*">
                        <ctl:DonutControl x:Name="Donut" Width="140" Height="140" Margin="0,10" HorizontalAlignment="Center"/>
                        <ItemsControl x:Name="CategoryList" Grid.Column="1" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                                        <Border Width="10" Height="10" Background="{Binding Color}" CornerRadius="3"/>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#5a6058"/>
                                        <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="Bold" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="White" BorderBrush="#e9e5dc" BorderThickness="1" CornerRadius="16" Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="成员汇总明细" FontSize="14" FontWeight="Bold"/>
                <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,1*,1*" Margin="8,0">
                    <TextBlock Text="成员" FontSize="12" Foreground="#99a096"/>
                    <TextBlock Text="收入" FontSize="12" Foreground="#99a096" Grid.Column="1"/>
                    <TextBlock Text="支出" FontSize="12" Foreground="#99a096" Grid.Column="2"/>
                    <TextBlock Text="结余" FontSize="12" Foreground="#99a096" Grid.Column="3"/>
                    <TextBlock Text="存款本金" FontSize="12" Foreground="#99a096" Grid.Column="4"/>
                    <TextBlock Text="应计利息" FontSize="12" Foreground="#99a096" Grid.Column="5"/>
                    <TextBlock Text="本息合计" FontSize="12" Foreground="#99a096" Grid.Column="6"/>
                </Grid>
                <ItemsControl x:Name="MemberList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*,1*,1*" Margin="8,7">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Income}" FontSize="13" Foreground="#2f9e6e" Grid.Column="1"/>
                                <TextBlock Text="{Binding Expense}" FontSize="13" Foreground="#c4553d" Grid.Column="2"/>
                                <TextBlock Text="{Binding Balance}" FontSize="13" FontWeight="Bold" Grid.Column="3"/>
                                <TextBlock Text="{Binding Principal}" FontSize="13" Grid.Column="4"/>
                                <TextBlock Text="{Binding Accrued}" FontSize="13" Grid.Column="5"/>
                                <TextBlock Text="{Binding Total}" FontSize="13" FontWeight="Bold" Grid.Column="6"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
