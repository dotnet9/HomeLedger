<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HomeLedger.Avalonia.Views.Pages.AdminMembersPage">
    <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="成员管理" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Width="34" Height="4" VerticalAlignment="Center" Margin="10,12,0,0" Background="#d9a441"/>
        </StackPanel>
        <TextBlock Text="创建家庭成员账号 · 停用后不能登录但数据保留" FontSize="13" Foreground="#99a096" Margin="0,-8,0,0"/>

        <Button Content="＋ 新建成员账号" Click="OnCreate" Background="#147d64" Foreground="White" CornerRadius="10"
                HorizontalAlignment="Left"/>

        <Border Background="White" BorderBrush="#e9e5dc" BorderThickness="1" CornerRadius="16" Padding="16">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="1*,1.2*,0.9*,0.9*,0.8*,1.1*,2.2*" Margin="8,0">
                    <TextBlock Text="用户名" FontSize="12" Foreground="#99a096"/>
                    <TextBlock Text="显示名" FontSize="12" Foreground="#99a096" Grid.Column="1"/>
                    <TextBlock Text="角色" FontSize="12" Foreground="#99a096" Grid.Column="2"/>
                    <TextBlock Text="状态" FontSize="12" Foreground="#99a096" Grid.Column="3"/>
                    <TextBlock Text="记录数" FontSize="12" Foreground="#99a096" Grid.Column="4"/>
                    <TextBlock Text="创建时间" FontSize="12" Foreground="#99a096" Grid.Column="5"/>
                    <TextBlock Text="操作" FontSize="12" Foreground="#99a096" Grid.Column="6" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl x:Name="ListHost">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="1*,1.2*,0.9*,0.9*,0.8*,1.1*,2.2*" Margin="8,8" MinHeight="28">
                                <TextBlock Text="{Binding Username}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Grid.Column="1" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{Binding RoleBg}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RoleText}" FontSize="11" Foreground="{Binding RoleFg}"/>
                                </Border>
                                <Border Grid.Column="3" Background="{Binding ActiveBg}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveText}" FontSize="11" Foreground="{Binding ActiveFg}"/>
                                </Border>
                                <TextBlock Text="{Binding TxCount}" FontSize="13" Grid.Column="4" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CreatedAt}" FontSize="13" Foreground="#99a096" Grid.Column="5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="重置密码" FontSize="12" CornerRadius="8" Padding="10,4" Margin="0,0,6,0" Command="{Binding ResetCommand}" IsVisible="{Binding IsMember}"/>
                                    <Button Content="{Binding ToggleText}" FontSize="12" CornerRadius="8" Padding="10,4" Command="{Binding ToggleCommand}" IsVisible="{Binding IsMember}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
