<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:HomeLedger.Core.I18n" xmlns:codewf="https://codewf.com" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HomeLedger.Avalonia.Views.Pages.AdminMembersPage">
    <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{codewf:I18n {x:Static l:Language.MemberManagement}}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Width="34" Height="4" VerticalAlignment="Center" Margin="10,12,0,0" Background="{DynamicResource StudioAccent}"/>
        </StackPanel>
        <TextBlock Text="{codewf:I18n {x:Static l:Language.MembersDescription}}" FontSize="13" Foreground="{DynamicResource StudioMuted}" Margin="0,-8,0,0"/>

        <Grid ColumnDefinitions="260,*,Auto" ColumnSpacing="12">
            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{codewf:I18n {x:Static l:Language.SearchMembers}}" />
            <Button Grid.Column="2" Content="{codewf:I18n {x:Static l:Language.AddMember}}" Command="{Binding CreateCommand}"
                Background="{DynamicResource StudioAccent}" Foreground="White" CornerRadius="10" />
        </Grid>

        <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="1*,1.2*,0.9*,0.9*,0.8*,1.1*,2.2*" Margin="8,0">
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Username}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.DisplayName}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="1"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Role}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="2"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Status}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="3"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.RecordCount}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="4"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.CreatedAt}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="5"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Actions}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="6" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Users}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="1*,1.2*,0.9*,0.9*,0.8*,1.1*,2.2*" Margin="8,8" MinHeight="28">
                                <TextBlock Text="{Binding Username}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Grid.Column="1" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{Binding RoleBg}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RoleText}" FontSize="12" Foreground="{Binding RoleFg}"/>
                                </Border>
                                <Border Grid.Column="3" Background="{Binding ActiveBg}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveText}" FontSize="12" Foreground="{Binding ActiveFg}"/>
                                </Border>
                                <TextBlock Text="{Binding TxCount}" FontSize="13" Grid.Column="4" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CreatedAt}" FontSize="13" Foreground="{DynamicResource StudioMuted}" Grid.Column="5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{codewf:I18n {x:Static l:Language.ResetPassword}}" FontSize="12" CornerRadius="8" Padding="10,4" Margin="0,0,6,0" Command="{Binding ResetCommand}" IsVisible="{Binding IsMember}"/>
                                    <Button Content="{Binding ToggleText}" FontSize="12" CornerRadius="8" Padding="10,4" Command="{Binding ToggleCommand}" IsVisible="{Binding IsMember}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
