<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:HomeLedger.Core.I18n" xmlns:codewf="https://codewf.com" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HomeLedger.Avalonia.Views.Pages.AdminBackupPage">
    <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{codewf:I18n {x:Static l:Language.DataBackup}}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Width="34" Height="4" VerticalAlignment="Center" Margin="10,12,0,0" Background="{DynamicResource StudioAccent}"/>
        </StackPanel>
        <TextBlock Text="{codewf:I18n {x:Static l:Language.BackupDescription}}" FontSize="13" Foreground="{DynamicResource StudioMuted}" Margin="0,-8,0,0"/>

        <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="24" MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel Spacing="14">
                <TextBlock Text="{codewf:I18n {x:Static l:Language.DatabaseLocation}}" FontSize="13" Foreground="{DynamicResource StudioText}"/>
                <TextBox x:Name="DbPathText" IsReadOnly="True" FontSize="12" TextWrapping="Wrap"/>
                <Button x:Name="BackupButton" Content="{codewf:I18n {x:Static l:Language.BackupDatabase}}" Click="OnBackup" Background="{DynamicResource StudioAccent}" Foreground="White" CornerRadius="10" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ResultText" FontSize="12" Foreground="{DynamicResource FinanceIncome}" TextWrapping="Wrap" IsVisible="False"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
