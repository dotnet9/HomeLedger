<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:HomeLedger.Core.I18n" xmlns:codewf="https://codewf.com" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HomeLedger.Avalonia.Views.Pages.MemberLedgerPage">
    <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{codewf:I18n {x:Static l:Language.Ledger}}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Width="34" Height="4" VerticalAlignment="Center" Margin="10,12,0,0" Background="{DynamicResource StudioAccent}"/>
        </StackPanel>
        <TextBlock Text="{codewf:I18n {x:Static l:Language.QuickEntryDescription}}" FontSize="13" Foreground="{DynamicResource StudioMuted}" Margin="0,-8,0,0"/>

        <!-- 快速记账 -->
        <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="18"
                KeyDown="OnQuickFormKeyDown">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="170,160,150,160,*,120" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{codewf:I18n {x:Static l:Language.Amount}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
                        <TextBox x:Name="QuickAmountBox"
                                 Text="{Binding QuickAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="￥ 0.00"
                                 Height="48"
                                 FontSize="21"
                                 FontWeight="Bold"
                                 FontFamily="Georgia"
                                 CornerRadius="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{codewf:I18n {x:Static l:Language.Type}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
                        <Border Height="36" Background="{DynamicResource StudioRaised}" CornerRadius="11" Padding="3">
                            <Border.Styles>
                                <Style Selector="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Foreground" Value="{DynamicResource StudioText}"/>
                                </Style>
                                <Style Selector="ToggleButton:checked">
                                    <Setter Property="Background" Value="{DynamicResource StudioSurface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </Border.Styles>
                            <UniformGrid Columns="2">
                                <ToggleButton Content="{codewf:I18n {x:Static l:Language.Expense}}" IsChecked="{Binding IsQuickExpense}"/>
                                <ToggleButton Content="{codewf:I18n {x:Static l:Language.Income}}" IsChecked="{Binding IsQuickIncome}"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="{codewf:I18n {x:Static l:Language.Category}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
                        <ComboBox ItemsSource="{Binding QuickCategories}" SelectedIndex="{Binding QuickCategoryIndex}" Height="36" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="6">
                        <TextBlock Text="{codewf:I18n {x:Static l:Language.Date}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
                        <CalendarDatePicker SelectedDate="{Binding QuickDate, Converter={StaticResource DateValueConverter}}" Height="36"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Spacing="6">
                        <TextBlock Text="{codewf:I18n {x:Static l:Language.Note}}" FontSize="12" Foreground="{DynamicResource StudioText}"/>
                        <TextBox Text="{Binding QuickNote, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{codewf:I18n {x:Static l:Language.Optional}}" Height="36" CornerRadius="10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Spacing="6">
                        <TextBlock Text=" " FontSize="12"/>
                        <Button Content="{codewf:I18n {x:Static l:Language.NewTransaction}}" Command="{Binding SaveQuickCommand}" Height="36"
                                Background="{DynamicResource StudioAccent}" Foreground="White" CornerRadius="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding QuickMessage}"
                           Foreground="{Binding QuickMessageBrush}"
                           FontSize="12"
                           IsVisible="{Binding HasQuickMessage}"/>
            </StackPanel>
        </Border>

        <!-- 汇总卡片 -->
        <UniformGrid Columns="4">
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="{DynamicResource StudioAccent}"/><TextBlock Text="{codewf:I18n {x:Static l:Language.MonthIncome}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/></StackPanel>
                    <TextBlock Text="{Binding MonthIncomeText}" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Foreground="{DynamicResource FinanceIncome}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="{DynamicResource StudioAccent}"/><TextBlock Text="{codewf:I18n {x:Static l:Language.MonthExpense}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/></StackPanel>
                    <TextBlock Text="{Binding MonthExpenseText}" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Foreground="{DynamicResource FinanceExpense}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,7,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="{DynamicResource StudioAccent}"/><TextBlock Text="{codewf:I18n {x:Static l:Language.MonthBalance}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/></StackPanel>
                    <TextBlock Text="{Binding MonthBalanceText}" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="7,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="6" Height="6" Background="{DynamicResource StudioAccent}"/><TextBlock Text="{codewf:I18n {x:Static l:Language.LifetimeBalance}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/></StackPanel>
                    <TextBlock Text="{Binding TotalBalanceText}" FontSize="24" FontWeight="Bold" FontFamily="Georgia" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 记录列表 -->
        <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16">
            <StackPanel Spacing="12">
                <WrapPanel Orientation="Horizontal" KeyDown="OnFilterAreaKeyDown">
                    <CalendarDatePicker SelectedDate="{Binding FromDate, Converter={StaticResource DateValueConverter}}" Width="150" Margin="0,0,10,8"/>
                    <TextBlock Text="~" VerticalAlignment="Center" Foreground="{DynamicResource StudioMuted}"/>
                    <CalendarDatePicker SelectedDate="{Binding ToDate, Converter={StaticResource DateValueConverter}}" Width="150" Margin="0,0,10,8"/>
                    <ComboBox x:Name="TransactionKindFilter" ItemsSource="{Binding KindFilterKeys}" SelectedIndex="{Binding KindFilterIndex}" MinWidth="120" Margin="0,0,10,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{codewf:I18n {Binding}}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding FilterCategories}" SelectedIndex="{Binding FilterCategoryIndex}" MinWidth="120">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{codewf:I18n {x:Static l:Language.SearchNotes}}" Width="190" Margin="0,0,10,8"
                             KeyDown="OnFilterKeywordKeyDown"/>
                    <Button Content="{codewf:I18n {x:Static l:Language.Filter}}" Command="{Binding FilterCommand}" CornerRadius="10"/>
                </WrapPanel>

                <Grid ColumnDefinitions="1.1*,0.8*,1.2*,1*,2.4*,1.1*" Margin="8,0">
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Date}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Type}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="1"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Category}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="2"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Amount}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="3"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Note}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="4"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Actions}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="5" HorizontalAlignment="Right"/>
                </Grid>
                <ScrollViewer MaxHeight="260">
                    <ItemsControl ItemsSource="{Binding Transactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="1.1*,0.8*,1.2*,1*,2.4*,1.1*" Margin="8,7" MinHeight="30">
                                    <TextBlock Text="{Binding DateText}" FontSize="13" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{Binding KindBg}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindText}" FontSize="12" Foreground="{Binding KindFg}"/>
                                    </Border>
                                    <TextBlock Text="{Binding CategoryName}" FontSize="13" Grid.Column="2" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AmountText}" FontSize="13" FontWeight="Bold" Foreground="{Binding AmountBrush}" Grid.Column="3" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Note}" FontSize="13" Foreground="{DynamicResource StudioText}" Grid.Column="4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{codewf:I18n {x:Static l:Language.Edit}}" FontSize="12" CornerRadius="8" Padding="10,4" Margin="0,0,6,0" Command="{Binding EditCommand}"/>
                                        <Button Content="{codewf:I18n {x:Static l:Language.Delete}}" FontSize="12" CornerRadius="8" Padding="10,4" Foreground="{DynamicResource FinanceExpense}" Command="{Binding DeleteCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" FontSize="12" />
                    <Button Content="{codewf:I18n {x:Static l:Language.PreviousPage}}" Command="{Binding PreviousPageCommand}" />
                    <Button Content="{codewf:I18n {x:Static l:Language.NextPage}}" Command="{Binding NextPageCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
