<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:HomeLedger.Core.I18n" xmlns:codewf="https://codewf.com" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HomeLedger.Avalonia.Views.Pages.AdminDetailsPage">
    <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{codewf:I18n {x:Static l:Language.TransactionDetails}}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Width="34" Height="4" VerticalAlignment="Center" Margin="10,12,0,0" Background="{DynamicResource StudioAccent}"/>
        </StackPanel>
        <TextBlock Text="{codewf:I18n {x:Static l:Language.DetailsDescription}}" FontSize="13" Foreground="{DynamicResource StudioMuted}" Margin="0,-8,0,0"/>

        <Border Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="16" Padding="16">
            <StackPanel Spacing="12">
                <WrapPanel Orientation="Horizontal" KeyDown="OnFilterAreaKeyDown">
                    <CalendarDatePicker Width="150" SelectedDate="{Binding FromDate, Converter={StaticResource DateValueConverter}}" Height="36" Margin="0,0,10,10"/>
                    <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource StudioMuted}"/>
                    <CalendarDatePicker Width="150" SelectedDate="{Binding ToDate, Converter={StaticResource DateValueConverter}}" Height="36" Margin="0,0,10,10"/>
                    <ComboBox MinWidth="120" ItemsSource="{Binding Members}" SelectedIndex="{Binding MemberFilterIndex}" Height="36" Margin="0,0,10,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox MinWidth="120" SelectedIndex="{Binding KindFilterIndex}" Height="36" Margin="0,0,10,10">
                        <ComboBoxItem Content="{codewf:I18n {x:Static l:Language.AllTypes}}" IsSelected="True"/>
                        <ComboBoxItem Content="{codewf:I18n {x:Static l:Language.Income}}"/>
                        <ComboBoxItem Content="{codewf:I18n {x:Static l:Language.Expense}}"/>
                    </ComboBox>
                    <ComboBox MinWidth="120" ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryFilterIndex}" Height="36" Margin="0,0,10,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Width="190" x:Name="KeywordBox" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{codewf:I18n {x:Static l:Language.SearchNotesHint}}" Height="36" Margin="0,0,10,10"
                             KeyDown="OnKeywordKeyDown"/>
                    <Button Content="{codewf:I18n {x:Static l:Language.Filter}}" Command="{Binding FilterCommand}" CornerRadius="10" Margin="0,0,10,10"/>
                    <Button Content="{codewf:I18n {x:Static l:Language.ExportCurrentView}}" Command="{Binding ExportCsvCommand}" CornerRadius="10" Margin="0,0,10,10"/>
                </WrapPanel>

                <Grid ColumnDefinitions="1*,1.1*,0.8*,1.2*,1*,2.6*" Margin="8,2,8,0">
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Member}}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Date}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="1"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Type}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="2"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Category}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="3"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Amount}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="4"/>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.Note}}" FontSize="12" Foreground="{DynamicResource StudioMuted}" Grid.Column="5"/>
                </Grid>

                <ScrollViewer Height="500">
                    <ItemsControl ItemsSource="{Binding Transactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="1*,1.1*,0.8*,1.2*,1*,2.6*" Margin="8,7" MinHeight="30">
                                    <TextBlock Text="{Binding MemberName}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DateText}" FontSize="13" Grid.Column="1" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="{Binding KindBg}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindText}" FontSize="12" Foreground="{Binding KindFg}"/>
                                    </Border>
                                    <TextBlock Text="{Binding CategoryName}" FontSize="13" Grid.Column="3" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AmountText}" FontSize="13" FontWeight="Bold" Foreground="{Binding AmountBrush}" Grid.Column="4" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Note}" FontSize="13" Foreground="{DynamicResource StudioText}" Grid.Column="5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="{DynamicResource StudioMuted}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" Foreground="{Binding StatusBrush}" FontSize="12"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
