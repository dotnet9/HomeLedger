<jade:JadeWindow xmlns="https://github.com/avaloniaui" xmlns:jade="using:HomeLedger.Avalonia.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeLedger.Avalonia.Views.LoginWindow"
        Title="HomeLedger 家庭记账 · 登录" Width="440" Height="560"
        WindowStartupLocation="CenterScreen" CanResize="False"
        Background="#f7f5f0">
    <Border Margin="16" CornerRadius="16" Background="White" BorderBrush="#e9e5dc" BorderThickness="1"
            BoxShadow="0 16 50 0 #1e463724">
        <ScrollViewer>
            <StackPanel Margin="36,32" Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#147d64" Offset="0"/>
                                <GradientStop Color="#3aa08a" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="¥" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="家庭记账" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="记录一家人的收入与支出" FontSize="12" Foreground="#99a096"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="用户名" FontSize="12" Foreground="#5a6058" Margin="0,10,0,0"/>
                <TextBox x:Name="UsernameBox" Watermark="用户名" Height="38"/>

                <TextBlock Text="密码" FontSize="12" Foreground="#5a6058"/>
                <TextBox x:Name="PasswordBox" Watermark="密码" Height="38" PasswordChar="●"/>

                <Button x:Name="LoginButton" Content="登 录" Click="OnLogin" Height="40" Margin="0,8,0,0"
                        Background="#147d64" Foreground="White" CornerRadius="10" FontWeight="Bold"/>

                <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Foreground="#c4553d"
                           IsVisible="False" Margin="0,4,0,0"/>

                <TextBlock Text="首次启动管理员：admin / admin123（首次登录需改密）"
                           FontSize="11" Foreground="#99a096" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</jade:JadeWindow>
