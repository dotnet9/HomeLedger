<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui" xmlns:codewf="https://codewf.com"
        xmlns:l="using:HomeLedger.Core.I18n" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HomeLedger.Avalonia.Views.LoginWindow"
        Title="{codewf:I18n {x:Static l:Language.AppTitle}}" Width="1280" Height="840" MinWidth="960" MinHeight="640"
        Icon="avares://HomeLedger.Avalonia/Assets/logo.ico"
        WindowStartupLocation="CenterScreen" CanResize="True"
        Background="{DynamicResource StudioBackground}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="{DynamicResource StudioBackgroundColor}" Offset="0" />
                <GradientStop Color="{DynamicResource StudioBackgroundColor}" Offset="0.42" />
                <GradientStop Color="{DynamicResource StudioBackgroundColor}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="150" Canvas.Top="84" Width="560" Height="300" Fill="#1a147d64" />
            <Ellipse Canvas.Left="930" Canvas.Top="515" Width="480" Height="280" Fill="#1fd9a441" />
            <Ellipse Canvas.Left="90" Canvas.Top="130" Width="150" Height="150" Stroke="#12147d64" StrokeThickness="14" />
            <Ellipse Canvas.Left="1100" Canvas.Top="588" Width="90" Height="90" Stroke="#1fd9a441" StrokeThickness="10" />
        </Canvas>

        <Border Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource StudioSurface}"
                BorderBrush="{DynamicResource StudioBorder}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="36,38,36,28"
                BoxShadow="0 16 50 0 #1e463724">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
                    <Border Width="44" Height="44" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="{DynamicResource StudioAccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource StudioAccentColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="¥" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.FamilyLedger}}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{codewf:I18n {x:Static l:Language.Tagline}}" FontSize="13" Foreground="{DynamicResource StudioMuted}" Margin="0,0,0,26" TextWrapping="Wrap"/>

                <Border Background="{DynamicResource StudioRaised}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="10" Padding="10,9" Margin="0,0,0,16">
                    <TextBlock Text="{codewf:I18n {x:Static l:Language.FirstLoginHint}}" FontSize="12" Foreground="{DynamicResource StudioAccent}" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="{codewf:I18n {x:Static l:Language.Username}}" FontSize="12" Foreground="{DynamicResource StudioText}" Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox" PlaceholderText="{codewf:I18n {x:Static l:Language.Username}}" Height="40" Margin="0,0,0,16" CornerRadius="10"
                         TextChanged="OnLoginInputChanged"
                         KeyDown="OnUsernameKeyDown"/>

                <TextBlock Text="{codewf:I18n {x:Static l:Language.Password}}" FontSize="12" Foreground="{DynamicResource StudioText}" Margin="0,0,0,6"/>
                <TextBox x:Name="PasswordBox" PlaceholderText="{codewf:I18n {x:Static l:Language.Password}}" Height="40" Margin="0,0,0,6" CornerRadius="10" PasswordChar="●"
                         TextChanged="OnLoginInputChanged"/>

                <Button x:Name="LoginButton" Content="{codewf:I18n {x:Static l:Language.Login}}" Click="OnLogin" Height="40" Margin="0,6,0,0"
                        HorizontalAlignment="Stretch" Foreground="White" CornerRadius="10" FontWeight="Bold" FontSize="14"
                        IsDefault="True" IsEnabled="False">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="{DynamicResource StudioAccentColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource StudioAccentColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource FinanceExpense}"
                           IsVisible="False" Margin="0,12,0,0"/>

                <TextBlock Text="{codewf:I18n {x:Static l:Language.LocalDataHint}}"
                           FontSize="12" Foreground="{DynamicResource StudioMuted}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</codewf:CodeWFWindow>
