<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:services="using:HomeLedger.Avalonia.Services"
             x:Class="HomeLedger.Desktop.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <services:DateValueConverter x:Key="DateValueConverter" />
    </Application.Resources>
    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN" />
        <codewf:ACSemiTheme />
        <codewf:StudioTheme />
        <StyleInclude Source="avares://HomeLedger.Avalonia/Themes/Finance.axaml" />
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource StudioBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
        </Style>
    </Application.Styles>
</Application>
